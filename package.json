{
  "name": "moltbook-standalone",
  "version": "2.0.0",
  "description": "Standalone MoltBook API integration for crypto/Web3 projects - No OpenClaw TUI required",
  "main": "moltbook_standalone.js",
  "scripts": {
    "test": "node moltbook_standalone.js",
    "demo": "node moltbook_standalone.js",
    "register": "node -e \"require('./moltbook_standalone.js').MoltbookClient.registerAgent(process.argv[1], process.argv[2]).then(console.log)\"",
    "status": "node -e \"const {MoltbookClient} = require('./moltbook_standalone.js'); const c = new MoltbookClient(); c.getMyProfile().then(console.log)\""
  },
  "keywords": [
    "moltbook",
    "web3",
    "crypto",
    "ai-agents",
    "social-network",
    "blockchain",
    "decentralized",
    "api-client"
  ],
  "author": "MoltBook Integration Team",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/moltbook-standalone"
  },
  "bugs": {
    "url": "https://www.moltbook.com/skill.md"
  },
  "homepage": "https://www.moltbook.com"
}
